DATABASE_URL=mongodb://127.0.0.1:27017/finance-platform
# Or MongoDB Atlas:
# DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/finance-platform?retryWrites=true&w=majority

VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_SIGN_IN_URL=/sign-in
VITE_CLERK_SIGN_UP_URL=/sign-up

# Powers receipt scanning and the AI financial advisor.
# Without it the advisor falls back to rule-based tips.
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-latest. Override if that alias changes.
GEMINI_MODEL=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Finance App

PORT=3001
